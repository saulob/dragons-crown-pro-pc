+// Filled behind the panel: on SDL's software renderer a stroked rounded rectangle loses whole sides.
+void Launcher::OutlinePanel(ImVec2 size) {
+  const float line = layout::PanelBorderWidth(s_);
+  const ImVec2 min = ImGui::GetCursorScreenPos();
+  const ImVec2 outer(std::floor(min.x) - line, std::floor(min.y) - line);
+  const ImVec2 outer_end(std::floor(min.x) + std::floor(size.x) + line, std::floor(min.y) + std::floor(size.y) + line);
+  ImGui::GetWindowDrawList()->AddRectFilled(outer, outer_end, Col(config_.theme.border_panel),
+                                            ImGui::GetStyle().ChildRounding + line);
 }
 
