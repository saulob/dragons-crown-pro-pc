+void Ui::SponsorCard(const char* message, const char* note) {
+  LeaveRows();
+  const SponsorLink& sponsor = launcher_->config_.sponsor;
+  if (sponsor.url.empty()) return;
+  const Theme& t = theme();
+  const float s = scale_;
+  const ImVec2 p = ImGui::GetCursorScreenPos();
+  const float w = ImGui::GetContentRegionAvail().x;
+  const float pad = 18 * s, gap = 24 * s, paragraph_gap = 16 * s, link_gap = 8 * s;
+  const float font_size = ImGui::GetFontSize();
+  ImFont* font = fonts().semibold;
+  const ImVec2 button(SponsorButtonWidth(sponsor, font, font_size, s), 40 * s);
+  const float text_w = std::max(w - button.x - gap - pad * 2, 160 * s);
+  const float message_h = ImGui::CalcTextSize(message, nullptr, false, text_w).y;
+  const float note_h = ImGui::CalcTextSize(note, nullptr, false, text_w).y;
+  const float link_size = fonts().size * 0.84f * s;
+  const float h = std::max(message_h + paragraph_gap + note_h, button.y + link_gap + link_size) + pad * 2;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  dl->AddRectFilled(p, ImVec2(p.x + w, p.y + h), Col(t.frame, 0.35f), 12 * s);
+  dl->AddRect(p, ImVec2(p.x + w, p.y + h), Col(t.frame_hot, 0.8f), 12 * s, 0, std::max(s, 1.0f));
+
+  ImGui::SetCursorScreenPos(ImVec2(p.x + pad, p.y + pad));
+  ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + text_w);
+  ImGui::TextUnformatted(message);
+  ImGui::SetCursorScreenPos(ImVec2(p.x + pad, p.y + pad + message_h + paragraph_gap));
+  ImGui::PushStyleColor(ImGuiCol_Text, t.dim);
+  ImGui::TextUnformatted(note);
+  ImGui::PopStyleColor();
+  ImGui::PopTextWrapPos();
+
+  const float button_x = p.x + w - pad - button.x;
+  if (SponsorButton("##sponsor_card", sponsor, ImVec2(button_x, p.y + pad), button, font, font_size, s)) {
+    OpenUrl(sponsor.url);
+  }
+  std::string shown = sponsor.url;
+  const size_t scheme = shown.find("://");
+  if (scheme != std::string::npos) shown.erase(0, scheme + 3);
+  ImFont* link_font = fonts().regular;
+  const float link_w = link_font->CalcTextSizeA(link_size, FLT_MAX, 0.0f, shown.c_str()).x;
+  ImGui::PushItemFlag(ImGuiItemFlags_NoNav, true);
+  LinkText(dl, "##sponsor_url", ImVec2(button_x + (button.x - link_w) * 0.5f, p.y + pad + button.y + link_gap),
+           link_font, link_size, Col(kSponsorLinkColor), shown.c_str(), sponsor.url);
+  ImGui::PopItemFlag();
+
+  ImGui::SetCursorScreenPos(ImVec2(p.x, p.y + h + 14 * s));
+  ImGui::Dummy(ImVec2(0, 0));
+}
+
