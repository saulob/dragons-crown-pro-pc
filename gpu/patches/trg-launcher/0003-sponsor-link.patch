+const ImVec4 kSponsorPink(0.79f, 0.18f, 0.50f, 1.0f);
+const ImVec4 kSponsorPinkHot(0.88f, 0.27f, 0.59f, 1.0f);
+const ImVec4 kSponsorPinkActive(0.68f, 0.14f, 0.43f, 1.0f);
+const ImVec4 kSponsorLinkColor(0.92f, 0.40f, 0.68f, 1.0f);
+
+float SponsorIconSize(float font_size) { return font_size * 1.1f; }
+
+float SponsorButtonWidth(const SponsorLink& sponsor, ImFont* font, float font_size, float scale) {
+  const float text = font->CalcTextSizeA(font_size, FLT_MAX, 0.0f, sponsor.label.c_str()).x;
+  if (sponsor.icon == ImTextureID{}) return text + 48 * scale;
+  return text + SponsorIconSize(font_size) + 8 * scale + 28 * scale;
+}
+
+bool SponsorButton(const char* id, const SponsorLink& sponsor, ImVec2 pos, ImVec2 size, ImFont* font,
+                   float font_size, float scale) {
+  ImGui::SetCursorScreenPos(pos);
+  ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 12 * scale);
+  ImGui::PushStyleColor(ImGuiCol_Button, kSponsorPink);
+  ImGui::PushStyleColor(ImGuiCol_ButtonHovered, kSponsorPinkHot);
+  ImGui::PushStyleColor(ImGuiCol_ButtonActive, kSponsorPinkActive);
+  const bool pressed = ImGui::Button(id, size);
+  ImGui::PopStyleColor(3);
+  ImGui::PopStyleVar();
+  if (ImGui::IsItemHovered()) {
+    ImGui::SetMouseCursor(ImGuiMouseCursor_Hand);
+    ImGui::SetItemTooltip("%s", sponsor.url.c_str());
+  }
+  const ImVec2 min = ImGui::GetItemRectMin();
+  const ImVec2 text = font->CalcTextSizeA(font_size, FLT_MAX, 0.0f, sponsor.label.c_str());
+  const bool has_icon = sponsor.icon != ImTextureID{};
+  const float icon = has_icon ? SponsorIconSize(font_size) : 0.0f;
+  const float gap = has_icon ? 8 * scale : 0.0f;
+  const float x = min.x + (size.x - (icon + gap + text.x)) * 0.5f;
+  const float cy = min.y + size.y * 0.5f;
+  ImDrawList* dl = ImGui::GetWindowDrawList();
+  if (has_icon) {
+    dl->AddImage(ImTextureRef(sponsor.icon), ImVec2(x, cy - icon * 0.5f), ImVec2(x + icon, cy + icon * 0.5f));
+  }
+  dl->AddText(font, font_size, ImVec2(x + icon + gap, cy - text.y * 0.5f), IM_COL32_WHITE, sponsor.label.c_str());
+  return pressed;
+}
+
 }  // namespace
 
