diff --git a/include/trg/layout.h b/include/trg/layout.h
index 3c61359..d87a72b 100644
--- a/include/trg/layout.h
+++ b/include/trg/layout.h
@@ -83,6 +83,25 @@ inline float SidebarRowFor(int pages, float body_height) {
   return std::clamp(std::floor(rows / float(pages)), kSidebarRowMin, kSidebarRow);
 }
 
+// A scrollbar takes the place of the right padding.
+inline float SidebarRowWidth(float sidebar_width, float scrollbar) {
+  return sidebar_width - kSidebarPadding - std::max(kSidebarPadding, scrollbar);
+}
+
+inline float SidebarRowTop(int index, float row) { return kSidebarPadding + float(index) * (row + kSidebarGap); }
+
+inline float SidebarScrollMax(int pages, float row, float body_height) {
+  return std::max(0.0f, SidebarHeight(pages, row) - body_height);
+}
+
+// The scroll nearest to `scroll` that shows the row and its padding whole.
+inline float SidebarScrollToShow(int index, int pages, float row, float body_height, float scroll) {
+  const float top = SidebarRowTop(index, row) - kSidebarPadding, bottom = top + row + kSidebarPadding * 2.0f;
+  if (bottom - scroll > body_height) scroll = bottom - body_height;
+  if (top < scroll) scroll = top;
+  return std::clamp(scroll, 0.0f, SidebarScrollMax(pages, row, body_height));
+}
+
 inline float ControlColumnWidth(float row_width, float scale) {
   return std::clamp(row_width * 0.34f, 280.0f * scale, 360.0f * scale);
 }
