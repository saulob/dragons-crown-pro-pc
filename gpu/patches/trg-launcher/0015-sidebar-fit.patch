+// The full row while every page fits, less in a window too short for that.
+inline float SidebarRowFor(int pages, float body_height) {
+  const float rows = body_height - SidebarHeight(pages, 0.0f);
+  return std::clamp(std::floor(rows / float(pages)), kSidebarRowMin, kSidebarRow);
