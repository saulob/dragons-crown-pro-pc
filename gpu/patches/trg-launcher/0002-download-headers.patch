+bool ValidHeader(const HttpHeader& header) {
+  if (header.name.empty()) {
+    return false;
+  }
+  for (const char c : header.name) {
+    if (!std::isalnum(static_cast<unsigned char>(c)) && c != '-' && c != '_') {
+      return false;
+    }
+  }
+  for (const char c : header.value) {
+    if (c == '\r' || c == '\n' || c == '\0') {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ValidOptions(const HttpOptions& options) {
+  if (options.user_agent.find_first_of("\r\n") != std::string::npos) {
+    return false;
+  }
+  for (const HttpHeader& header : options.headers) {
+    if (!ValidHeader(header)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
 
