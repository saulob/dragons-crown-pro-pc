+std::string Transfer(const std::string& url, const Sink& sink, Task* task, const HttpOptions& options) {
+  HttpReport local;
+  HttpReport& report = options.report ? *options.report : local;
+  report = HttpReport{};
+  if (!ValidOptions(options)) {
+    return "The request headers are not valid.";
+  }
+  ParsedUrl first;
+  if (!ParseUrl(url, first)) {
+    return kBadAddress;
+  }
+  report.host = first.host;
+
+  const auto started = Clock::now();
+  return FollowRedirects(
+      first, options, report, started,
+      [&](const ParsedUrl& target, bool same_origin, std::string& error, std::string& location) {
+        return FetchHop(target.Origin() + target.target, target, same_origin, started, options, sink, task, report, error, location);
+      });
