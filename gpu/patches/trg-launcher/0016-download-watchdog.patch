+// WinHTTP's own timeouts do not cover proxy discovery, redirects or a peer that stops mid-response, and a
+// synchronous call cannot be interrupted from its own thread. This closes the request handle from outside
+// when a stage runs out of time or the task is cancelled, which makes the blocked call return.
+class Watchdog {
+ public:
+  enum class Reason { kNone, kStalled, kTotal, kCancelled };
+
+  Watchdog(Task* task, Clock::time_point total_deadline) : task_(task), total_deadline_(total_deadline) {
+    thread_ = std::thread([this] { Run(); });
+  }
+  ~Watchdog() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    wake_.notify_all();
+    thread_.join();
+  }
+  Watchdog(const Watchdog&) = delete;
+  Watchdog& operator=(const Watchdog&) = delete;
+
+  void Arm(HINTERNET handle, int budget_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    handle_ = handle;
+    stage_deadline_ = Clock::now() + std::chrono::milliseconds(budget_ms);
+  }
+  void Touch(int budget_ms) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    stage_deadline_ = Clock::now() + std::chrono::milliseconds(budget_ms);
+  }
+  // True when the caller still owns the handle and must close it.
+  bool Release() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const bool owned = handle_ != nullptr;
+    handle_ = nullptr;
+    return owned;
+  }
+  Reason reason() const { return reason_.load(); }
+
+ private:
+  void Run() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stop_) {
+      wake_.wait_for(lock, std::chrono::milliseconds(50));
+      if (stop_ || !handle_ || reason_.load() != Reason::kNone) {
+        continue;
+      }
+      const auto now = Clock::now();
+      Reason fire = Reason::kNone;
+      if (task_ && task_->cancelled()) {
+        fire = Reason::kCancelled;
+      } else if (now >= total_deadline_) {
+        fire = Reason::kTotal;
+      } else if (now >= stage_deadline_) {
+        fire = Reason::kStalled;
+      }
+      if (fire != Reason::kNone) {
+        reason_ = fire;
+        HINTERNET handle = handle_;
+        handle_ = nullptr;
+        WinHttpCloseHandle(handle);
+      }
+    }
+  }
+
+  Task* task_;
+  Clock::time_point total_deadline_;
+  Clock::time_point stage_deadline_ = Clock::time_point::max();
+  HINTERNET handle_ = nullptr;
+  std::atomic<Reason> reason_{Reason::kNone};
+  bool stop_ = false;
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  std::thread thread_;
+};
