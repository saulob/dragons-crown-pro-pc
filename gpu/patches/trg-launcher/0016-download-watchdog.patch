+         error == ERROR_WINHTTP_SECURE_CERT_CN_INVALID || error == ERROR_WINHTTP_SECURE_INVALID_CA ||
+         error == ERROR_WINHTTP_SECURE_CERT_REV_FAILED || error == ERROR_WINHTTP_SECURE_CHANNEL_ERROR ||
+         error == ERROR_WINHTTP_SECURE_INVALID_CERT || error == ERROR_WINHTTP_SECURE_CERT_REVOKED ||
+         error == ERROR_WINHTTP_SECURE_CERT_WRONG_USAGE;
+}
+
+std::string FailureFor(DWORD error, Watchdog::Reason reason, bool receiving, HttpReport& report) {
+  report.system_error = error;
+  if (reason == Watchdog::Reason::kCancelled) {
+    report.cancelled = true;
+    return "Cancelled.";
   }
+  if (reason != Watchdog::Reason::kNone || error == ERROR_WINHTTP_TIMEOUT) {
+    report.timed_out = true;
+    report.transient = true;
+    return kTooSlow;
+  }
+  if (receiving) {
+    report.interrupted = true;
+    report.transient = true;
+    return kInterrupted;
+  }
+  report.transient = !IsSecurityError(error);
+  return kUnreachable;
+}
