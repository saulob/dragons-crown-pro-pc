+struct ParsedUrl {
+  std::string scheme;
+  std::string host;
+  int port = 0;
+  std::string target;  // path and query
+
+  bool Secure() const { return scheme == "https"; }
+  bool SameOrigin(const ParsedUrl& other) const {
+    return scheme == other.scheme && host == other.host && port == other.port;
+  }
+  std::string Origin() const {
+    const bool default_port = port == (Secure() ? 443 : 80);
+    return scheme + "://" + host + (default_port ? std::string() : ":" + std::to_string(port));
+  }
+};
+
+std::string Lower(std::string text) {
+  for (char& c : text) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return text;
+}
+
+bool ParseUrl(const std::string& url, ParsedUrl& out) {
+  for (const char c : url) {
+    if (static_cast<unsigned char>(c) <= 0x20 || static_cast<unsigned char>(c) >= 0x7f || c == '\\') {
+      return false;
+    }
+  }
+  const size_t scheme_end = url.find("://");
+  if (scheme_end == std::string::npos) {
+    return false;
+  }
+  out.scheme = Lower(url.substr(0, scheme_end));
+  if (out.scheme != "https" && out.scheme != "http") {
+    return false;
+  }
+  std::string rest = url.substr(scheme_end + 3);
+  if (const size_t fragment = rest.find('#'); fragment != std::string::npos) {
+    rest.resize(fragment);
+  }
+  const size_t authority_end = rest.find_first_of("/?");
+  const std::string authority = rest.substr(0, authority_end);
+  out.target = authority_end == std::string::npos ? "/" : rest.substr(authority_end);
+  if (out.target[0] == '?') {
+    out.target.insert(out.target.begin(), '/');
+  }
+  if (authority.empty() || authority.find('@') != std::string::npos) {
+    return false;
+  }
+  std::string port_text;
+  if (authority[0] == '[') {
+    const size_t close = authority.find(']');
+    if (close == std::string::npos) {
+      return false;
+    }
+    out.host = authority.substr(1, close - 1);
+    if (close + 1 < authority.size()) {
+      if (authority[close + 1] != ':') {
+        return false;
+      }
+      port_text = authority.substr(close + 2);
+    }
+  } else {
+    const size_t colon = authority.rfind(':');
+    out.host = authority.substr(0, colon);
+    if (colon != std::string::npos) {
+      port_text = authority.substr(colon + 1);
+    }
+  }
+  if (out.host.empty()) {
+    return false;
+  }
+  for (const char c : out.host) {
+    if (!std::isalnum(static_cast<unsigned char>(c)) && c != '.' && c != '-' && c != '_' && c != ':') {
+      return false;
+    }
+  }
+  out.host = Lower(out.host);
+  out.port = out.Secure() ? 443 : 80;
+  if (!port_text.empty()) {
+    char* end = nullptr;
+    const long port = std::strtol(port_text.c_str(), &end, 10);
+    if (*end != '\0' || port <= 0 || port > 65535) {
+      return false;
+    }
+    out.port = static_cast<int>(port);
+  }
+  return true;
+}
+
+std::string ResolveLocation(const ParsedUrl& base, const std::string& location) {
+  if (location.rfind("https://", 0) == 0 || location.rfind("http://", 0) == 0) {
+    return location;
+  }
+  if (location.rfind("//", 0) == 0) {
+    return base.scheme + ":" + location;
+  }
+  if (!location.empty() && location[0] == '/') {
+    return base.Origin() + location;
+  }
+  std::string directory = base.target.substr(0, base.target.find('?'));
+  directory.resize(directory.rfind('/') + 1);
+  return base.Origin() + directory + location;
+}
+
+bool IsRedirectStatus(int status) {
+  return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
+}
+
+bool IsTransientStatus(int status) {
+  return status == 408 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504;
+}
+
+long long ElapsedMs(Clock::time_point since) {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - since).count();
+}
+
+void LogResult(const HttpOptions& options, const HttpReport& report, const char* outcome, Clock::time_point started) {
+  if (!options.log) {
+    return;
+  }
+  options.log("http " + (options.operation.empty() ? std::string("request") : options.operation) + ": " + outcome +
+              " host=" + report.host + " status=" + std::to_string(report.status) +
+              " error=" + std::to_string(report.system_error) + " bytes=" + std::to_string(report.bytes) + "/" +
+              std::to_string(report.expected) + " redirects=" + std::to_string(report.redirects) +
+              " elapsed_ms=" + std::to_string(ElapsedMs(started)));
+}
+
+std::string StatusError(HttpReport& report) {
+  report.transient = IsTransientStatus(report.status);
+  return "The server answered " + std::to_string(report.status) + ".";
+}
+
+Clock::time_point TotalDeadline(const HttpOptions& options, Clock::time_point started) {
+  return options.total_timeout_ms > 0 ? started + std::chrono::milliseconds(options.total_timeout_ms)
+                                      : Clock::time_point::max();
+}
+
+long long ProgressTotal(const HttpOptions& options, const HttpReport& report) {
+  return options.progress_total > 0 ? options.progress_total : report.expected;
+}
+
+enum class Hop { kDone, kRedirect, kFailed };
+
+using HopFetch = std::function<Hop(const ParsedUrl& target, bool same_origin, std::string& error,
+                                   std::string& location)>;
+
+// Redirects are followed here, not by the backend, so each one is counted, logged and checked: only https may
+// stay https, and the caller's headers go to the first origin only.
+std::string FollowRedirects(const ParsedUrl& first, const HttpOptions& options, HttpReport& report,
+                            Clock::time_point started, const HopFetch& fetch) {
+  ParsedUrl current = first;
+  std::string error;
+  for (;;) {
+    std::string location;
+    const Hop hop = fetch(current, current.SameOrigin(first), error, location);
+    if (hop == Hop::kDone) {
+      error.clear();
+      break;
+    }
+    if (hop == Hop::kFailed) {
+      break;
+    }
+    if (report.redirects >= options.max_redirects) {
+      error = kTooManyRedirects;
+      break;
+    }
+    ParsedUrl next;
+    if (!ParseUrl(ResolveLocation(current, location), next)) {
+      error = kBadAddress;
+      break;
+    }
+    if (current.Secure() && !next.Secure()) {
+      error = kInsecureRedirect;
+      break;
+    }
+    ++report.redirects;
+    LogResult(options, report, "redirect", started);
+    current = std::move(next);
+  }
+  LogResult(options, report, error.empty() ? "done" : "failed", started);
+  return error;
+}
