+CurlResult ParseResultLine(const std::string& text) {
+  CurlResult result;
+  const size_t at = text.rfind(kResultMarker);
+  if (at == std::string::npos) {
+    return result;
+  }
+  const size_t line_end = text.find('\n', at);
+  const std::string line = text.substr(at + std::char_traits<char>::length(kResultMarker),
+                                       line_end == std::string::npos ? std::string::npos : line_end - at - 8);
+  result.status = std::atoi(line.c_str());
+  if (const size_t space = line.find(' '); space != std::string::npos) {
+    result.redirect = line.substr(space + 1);
+  }
+  return result;
+}
