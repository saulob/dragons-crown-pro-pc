# Turns the files a list names (one CMake list in a text file) into one C++ source: a TranslationFile table
# (game_translation.h) of their names and bytes, in the list's order.
#   cmake -DINPUT_LIST=<list.txt> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P embed_files.cmake
file(READ "${INPUT_LIST}" inputs)
set(arrays "")
set(table "")
set(count 0)
foreach(input IN LISTS inputs)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name "${input}" NAME)
    string(APPEND arrays "const uint8_t k${count}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", k${count}, ${size}},\n")
    math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUTPUT}" "// Generated by launcher/embed_files.cmake; do not edit.
#include \"game_translation.h\"

namespace dcp {
namespace {

${arrays}
} // namespace

extern const TranslationFile ${SYMBOL}[] = {
${table}    {nullptr, nullptr, 0},
};
extern const size_t ${SYMBOL}Count = ${count};

} // namespace dcp
")
