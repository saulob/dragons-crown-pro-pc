#include <winuser.h>
#include <winver.h>
#include "dcp_version.h"

1 ICON "../packaging/icons/app-icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "dragons_crown_pro.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DCP_VERSION_NUMBERS
PRODUCTVERSION DCP_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "Dragon's Crown Pro PC"
            VALUE "FileVersion", DCP_FILE_VERSION_STRING
            VALUE "InternalName", "dragons_crown_pro"
            VALUE "OriginalFilename", "dragons_crown_pro.exe"
            VALUE "ProductName", "Dragon's Crown Pro PC"
            VALUE "ProductVersion", DCP_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/dragons-crown-pro-pc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
